# Backend API Configuration
# Set VITE_API_MODE=local (default) to use the built-in interactive prototype state.
# Set VITE_API_MODE=remote to forward all workspace reads and writes to the backend REST API.
VITE_API_MODE=local
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_API_TIMEOUT_MS=15000
